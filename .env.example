# Kafka
KAFKA_BOOTSTRAP_SERVERS=pd-slave3:9092
KAFKA_STREAM_TOPIC=topic_stream
KAFKA_RESULTS_TOPIC=topic_results
KAFKA_TOPIC_PARTITIONS=14
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Spark
SPARK_HOME=/usr/local/spark
SPARK_MASTER=spark://pd-master:7077
SPARK_APP_NAME=Project_CosmicRays_Dashboard_application
SPARK_UI_PORT=4041
SPARK_TRIGGER_INTERVAL=5 seconds
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.1.2

# Cloud Veneto S3-compatible object storage
S3_ENDPOINT=https://cloud-areapd.pd.infn.it:5210
S3_BUCKET=mapd-minidt-stream
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_VERIFY_TLS=false

# Approx. 1000 rows/s in the original environment
PRODUCER_WAIT_SECONDS=0.00018

# Cluster helper scripts
KAFKA_HOST=pd-slave3
